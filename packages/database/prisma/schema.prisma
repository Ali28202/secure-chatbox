generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  runtime             = "bun"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  STUDENT
  PROFESSOR
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SystemEvent {
  MEMBER_ADDED
  MEMBER_REMOVED
}

enum ChatType {
  DIRECT
  COURSE_GROUP
  CUSTOM_GROUP
}

enum ChatRole {
  ADMIN
  MEMBER
}

enum ReceiptStatus {
  DELIVERED
  READ
}

model User {
  id           String     @id @default(uuid(7))
  universityId String     @unique @map("university_id")
  phoneNumber  String?    @unique @map("phone_number")
  passwordHash String     @map("password_hash")
  name         String
  role         GlobalRole @default(STUDENT)
  status       AccountStatus @default(PENDING)
  reviewedAt   DateTime?  @map("reviewed_at")
  reviewedById String?    @map("reviewed_by_id")
  isActive     Boolean    @default(true) @map("is_active")
  deviceId     String?    @map("device_id")
  lastSeen     DateTime?  @map("last_seen")
  avatarKey    String?    @map("avatar_key")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdChats    Chat[]           @relation("ChatCreator")
  memberships     ChatMember[]
  sentMessages    Message[]        @relation("MessageSender")
  systemMentions  Message[]        @relation("MessageSystemTarget")
  messageReceipts MessageReceipt[]
  reactions       MessageReaction[]
  sessions        Session[]
  reviewedBy      User?             @relation("AccountReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewed        User[]            @relation("AccountReviewer")
  @@index([role])
  @@index([status])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7))
  userId     String    @map("user_id")
  deviceId   String    @map("device_id")
  userAgent  String?   @map("user_agent") @db.VarChar(256)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Chat {
  id            String    @id @default(uuid(7))
  title         String?
  type          ChatType
  isReadOnly    Boolean   @default(false) @map("is_read_only")
  creatorId     String    @map("creator_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastMessageAt DateTime? @map("last_message_at")
  archivedAt    DateTime? @map("archived_at")
  deletedAt     DateTime? @map("deleted_at")

  creator  User         @relation("ChatCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members  ChatMember[]
  messages Message[]

  @@index([creatorId])
  @@index([lastMessageAt(sort: Desc)])
  @@index([archivedAt])
  @@index([deletedAt])
  @@map("chats")
}

model ChatMember {
  userId   String   @map("user_id")
  chatId   String   @map("chat_id")
  role     ChatRole @default(MEMBER)
  isMuted  Boolean  @default(false) @map("is_muted")
  joinedAt DateTime @default(now()) @map("joined_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  @@id([userId, chatId])
  @@index([chatId])
  @@map("chat_members")
}

model Message {
  id        String   @id @default(uuid(7))
  content   String?
  senderId  String   @map("sender_id")
  chatId    String   @map("chat_id")
  replyToId String?  @map("reply_to_id")
  isEdited  Boolean  @default(false) @map("is_edited")
  isDeleted Boolean  @default(false) @map("is_deleted")
  isPinned  Boolean  @default(false) @map("is_pinned")
  systemEvent    SystemEvent? @map("system_event")
  systemTargetId String?      @map("system_target_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sender       User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  systemTarget User? @relation("MessageSystemTarget", fields: [systemTargetId], references: [id], onDelete: SetNull)
  chat        Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  replyTo     Message?         @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]        @relation("MessageReplies")
  attachments Attachment[]
  receipts    MessageReceipt[]
  reactions   MessageReaction[]
  @@index([chatId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([replyToId])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("messages")
}

model Attachment {
  id          String @id @default(uuid(7))
  messageId   String @map("message_id")
  s3Bucket    String @map("s3_bucket")
  s3ObjectKey String @map("s3_object_key")
  fileName  String   @map("file_name")
  fileType  String   @map("file_type")
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@index([messageId])
  @@map("attachments")
}

model MessageReaction {
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageReceipt {
  messageId String        @map("message_id")
  userId    String        @map("user_id")
  status    ReceiptStatus @default(DELIVERED)
  timestamp DateTime      @default(now())
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([messageId, userId])
  @@index([userId, status])
  @@map("message_receipts")
}
