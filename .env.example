POSTGRES_USER=chatbox
POSTGRES_PASSWORD=chatbox_dev_pw
POSTGRES_DB=chatbox
POSTGRES_PORT=5432

DATABASE_URL="postgresql://chatbox:chatbox_dev_pw@localhost:5432/chatbox?schema=public"

NODE_ENV=development
API_PORT=3001

JWT_ACCESS_SECRET=replace-me-with-a-random-48-byte-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-random-secret-at-least-32-chars

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
ALLOWED_IP_RANGES=192.168.0.0/16,127.0.0.1,::1

DOMAIN=chat.example.com
LETSENCRYPT_EMAIL=you@example.com

METABASE_DOMAIN=panel.example.com

HTTP_PORT=80
HTTPS_PORT=443

PUBLIC_ORIGIN=

S3_BUCKET=chatbox-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_ENDPOINT=
S3_URL_TTL=300

METABASE_PORT=8080
METABASE_DB=metabase
METABASE_RO_USER=metabase_ro
METABASE_RO_PASSWORD=replace-me-before-deploying
METABASE_ENCRYPTION_KEY=replace-me-with-a-random-32-byte-key
METABASE_JAVA_OPTS=-Xmx1g
