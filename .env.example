# --- Postgres container (compose.yml) ---
POSTGRES_USER=chatbox
POSTGRES_PASSWORD=chatbox_dev_pw
POSTGRES_DB=chatbox
POSTGRES_PORT=5432

# --- Prisma ---
DATABASE_URL="postgresql://chatbox:chatbox_dev_pw@localhost:5432/chatbox?schema=public"

# --- API ---
NODE_ENV=development
API_PORT=3001

# --- Auth ---
JWT_ACCESS_SECRET=replace-me-with-a-random-48-byte-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-random-secret-at-least-32-chars

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
# Development only. In compose.prod.yml this is pinned to the compose subnet:
# nginx is the front door there, not this list. Leave empty to disable the check.
ALLOWED_IP_RANGES=192.168.0.0/16,127.0.0.1,::1

# --- Public deployment (compose.prod.yml) ---
# The hostname the certificate is issued for and the browser types. Required.
DOMAIN=chat.example.com
# Where Let's Encrypt sends expiry warnings. Required for the first issuance.
LETSENCRYPT_EMAIL=you@example.com

# Metabase's own hostname. Needs its own A record and its own certificate.
# It is a separate name on purpose: analytics is not the app, and putting it
# on a path under DOMAIN would share the app's origin and its cookies.
METABASE_DOMAIN=panel.example.com

HTTP_PORT=80
HTTPS_PORT=443

# Defaults to https://$DOMAIN. Override only if the browser reaches the site by
# some other name — it must match `Origin` exactly or every POST fails CSRF.
PUBLIC_ORIGIN=

S3_BUCKET=chatbox-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_ENDPOINT=
S3_URL_TTL=300

# The SSH-tunnel port, bound to 127.0.0.1 on the host. Public access to
# analytics goes through METABASE_DOMAIN over TLS instead; this stays as the
# way in when the certificate or DNS is broken.
METABASE_PORT=8080
METABASE_DB=metabase
METABASE_RO_USER=metabase_ro
METABASE_RO_PASSWORD=replace-me-before-deploying
METABASE_ENCRYPTION_KEY=replace-me-with-a-random-32-byte-key
METABASE_JAVA_OPTS=-Xmx1g
