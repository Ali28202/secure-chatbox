# Copy to .env and adjust. The root .env is the single source of truth for the
# whole monorepo: docker compose reads it, prisma.config.ts loads it by absolute
# path, and apps/api is started with --env-file=../../.env.

# --- Postgres container (compose.yml) ---
POSTGRES_USER=chatbox
POSTGRES_PASSWORD=chatbox_dev_pw
POSTGRES_DB=chatbox
POSTGRES_PORT=5432

# --- Prisma ---
# Must match the POSTGRES_* values above.
DATABASE_URL="postgresql://chatbox:chatbox_dev_pw@localhost:5432/chatbox?schema=public"

# --- API ---
NODE_ENV=development
API_PORT=3001

# --- Auth ---
# Two DIFFERENT secrets, at least 32 characters each. The API refuses to start
# if they match, because then a refresh token could be replayed as an access
# token. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-random-48-byte-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-random-secret-at-least-32-chars

# Seconds. The access token is short-lived by design; the refresh token is what
# keeps a user signed in.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Explicit rather than derived from NODE_ENV: the campus intranet may be served
# over plain HTTP, and a Secure cookie there is one the browser never sends.
# Set to true only when the deployment actually terminates TLS.
COOKIE_SECURE=false

# Comma-separated. Leave empty in production, where nginx puts the web client
# and the API on one origin and CORS never fires.
CORS_ORIGINS=http://localhost:3000

# Who may reach the API, as comma-separated CIDR blocks or single addresses.
# The default is the campus LAN plus loopback; nginx is the primary gate, and
# this keeps port 3001 closed to anyone who reaches the host directly.
# Leave empty to disable the check — needed if you run behind a reverse proxy
# that is not on one of these ranges, or in a container network such as Docker's
# default bridge (172.17.0.0/16), which is not covered by 192.168.0.0/16.
ALLOWED_IP_RANGES=192.168.0.0/16,127.0.0.1,::1

# --- Production (compose.prod.yml only) ---
# Everything above describes running the apps on your own machine against the
# database in compose.yml. `docker compose -f compose.prod.yml up -d --build`
# reads this same file, but overrides several of the values above because they
# mean something different inside the container network:
#
#   DATABASE_URL       rebuilt against `db:5432`, not localhost
#   CORS_ORIGINS       empty — nginx makes the app and the API one origin
#   ALLOWED_IP_RANGES  the compose network's subnet, since nginx is the only
#                      client the API ever has. The campus-LAN allow list moves
#                      to infra/nginx/conf.d/app.conf, where it is the front door
#
# What it does take from here: POSTGRES_*, the two JWT secrets, the token TTLs,
# COOKIE_SECURE and the whole S3 block. Generate real secrets before deploying —
# the placeholders above are not a starting point, they are a public value in a
# public file.
#
# One thing to know before deploying: attachments are the only part of this
# platform that leaves the campus network. Messages, accounts and sessions never
# do — but an S3 bucket is reached over the internet, by the API when a file is
# uploaded and by the browser when one is opened. If that is not acceptable for
# the coursework being sent, run an S3-compatible store on the university's own
# network and point S3_ENDPOINT at it; nothing else changes.

# Where nginx listens on the host. 80 is what makes the address a bare
# http://<server> with no port for people to remember or mistype.
HTTP_PORT=80

# Optional. The origin the browser actually uses, e.g. http://chat.university.local
# or http://192.168.1.10. Leave it empty unless you need to support a browser too
# old to send `Sec-Fetch-Site`, which is what the CSRF guard relies on when the
# app and the API share an origin.
PUBLIC_ORIGIN=

# --- Attachments (S3) ---
# Message attachments live in an S3 bucket. Nothing in this repository runs an
# object store: the bucket is somebody else's, it is reached over the network,
# and these five values are the whole of what the platform knows about it. Point
# them at AWS S3, at Arvan/ParsPack object storage, or at a MinIO you run
# yourself — the protocol is the same and the API cannot tell the difference.
#
# The bucket must exist and must stay private. The API never makes it public; it
# hands each browser a signed URL that expires, which only works if anonymous
# reads are refused.
S3_BUCKET=chatbox-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Leave empty for AWS S3 itself, which the client addresses from the region
# alone. Set it for anything else — e.g. https://s3.ir-thr-at1.arvanstorage.ir,
# or http://localhost:9000 for a MinIO on your own machine.
S3_ENDPOINT=

# How long a download link stays valid, in seconds. The API hands the browser a
# signed, expiring URL rather than the bytes themselves; five minutes is long
# enough to start a download of a large file, and short enough that a URL left
# in a browser's history is worthless by the time anyone else finds it.
S3_URL_TTL=300
