{
  "name": "secure-chatbox",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/.artifacts/report",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "lint:e2e": "eslint e2e",
    "test:s3:up": "docker run -d --rm --name chatbox-e2e-s3 -p 9000:9000 -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin --entrypoint sh minio/minio:RELEASE.2025-09-07T16-13-09Z -c 'mkdir -p /data/chatbox-e2e && exec minio server /data'",
    "test:s3:down": "docker rm -f chatbox-e2e-s3",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "bun --filter='@repo/database' db:generate",
    "db:migrate": "bun --filter='@repo/database' db:migrate",
    "db:deploy": "bun --filter='@repo/database' db:deploy",
    "db:reset": "bun --filter='@repo/database' db:reset",
    "db:studio": "bun --filter='@repo/database' db:studio",
    "db:seed": "bun --filter='@repo/database' db:seed",
    "analytics:up": "docker compose up -d metabase",
    "analytics:down": "docker compose stop metabase",
    "analytics:logs": "docker compose logs -f metabase",
    "prod:up": "docker compose -f compose.prod.yml up -d --build",
    "prod:down": "docker compose -f compose.prod.yml down",
    "prod:logs": "docker compose -f compose.prod.yml logs -f",
    "prod:ps": "docker compose -f compose.prod.yml ps",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
