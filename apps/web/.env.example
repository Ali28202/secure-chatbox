# Next.js reads env files from its own directory, not from the monorepo root,
# so this one variable lives here instead of in the root `.env` that the API,
# Prisma and docker compose share.
#
# You do not need a `.env.local` for development: `lib/api.ts` already defaults
# to `http://localhost:3001`, which is where `bun run dev` starts the API.

# Where the browser should send API requests.
#
# Development: the two apps are separate origins, so this is absolute.
# Production: nginx serves both under one origin, so the deployment sets this to
# an EMPTY string and requests go to same-origin `/api/...` paths.
#
# `NEXT_PUBLIC_*` is inlined into the client bundle at build time — changing it
# requires a rebuild, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:3001
