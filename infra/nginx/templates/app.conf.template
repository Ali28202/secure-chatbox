# Port 80 exists for two things only: proving control of the domain to Let's
# Encrypt, and sending everyone else to port 443. No application traffic is
# served here — the session cookies are `Secure` and would never be sent back.
server {
    listen      80 default_server;
    server_name ${DOMAIN};

    # Must stay reachable *unencrypted and unredirected*, or renewal fails and
    # the certificate silently expires 90 days later.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen      443 ssl default_server;
    http2       on;
    server_name ${DOMAIN};

    ssl_certificate         /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    ssl_stapling        on;
    ssl_stapling_verify on;

    # Docker's embedded DNS, and it has to be this one rather than a public
    # resolver: the `set` directives below name containers. It forwards external
    # queries too, so OCSP stapling still resolves through it.
    #
    # `valid=10s` is the whole point. An `upstream` block resolves its hostname
    # once, at startup, and keeps that address for the life of the process — so
    # recreating `api` or `web` leaves nginx proxying to an address nothing
    # answers on, and every request 502s until nginx is restarted by hand.
    resolver         127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # Only meaningful over TLS, which is why it lives here and not in the
    # http block. Once a browser has seen this it will refuse plain HTTP to
    # this name for a year — do not turn TLS off again casually.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options        SAMEORIGIN  always;
    add_header Referrer-Policy        same-origin always;

    location /socket.io/ {
        set $api http://api:3001;
        proxy_pass $api;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;

        proxy_buffering off;
    }

    # A speed bump on credential stuffing, not a lock. The real defence is
    # per-account lockout, which the API does not implement; this only slows
    # an attacker down, and it counts by IP, so a whole campus behind one NAT
    # shares the budget. Raise `rate` in nginx.conf if legitimate users are
    # being turned away with 429.
    location ~ ^/api/auth/(login|register)$ {
        limit_req      zone=auth_zone burst=20 nodelay;
        limit_req_status 429;

        set $api http://api:3001;
        proxy_pass $api;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        set $api http://api:3001;
        proxy_pass $api;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
        proxy_request_buffering on;
    }

    location /_next/static/ {
        set $web http://web:3000;
        proxy_pass $web;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;

        proxy_cache_valid 200 1y;
        # `add_header` in a location replaces the server block's set rather than
        # adding to it, so HSTS has to be repeated here or a first request that
        # happens to be a static asset would not carry it.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        set $web http://web:3000;
        proxy_pass $web;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
