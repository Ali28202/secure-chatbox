erDiagram
  users ||--o{ sessions : "signs in through"
  users ||--o{ chats : "creates"
  users ||--o{ chat_members : "belongs to"
  users ||--o{ messages : "sends"
  users |o--o{ messages : "is the subject of"
  users ||--o{ message_receipts : "reads"
  users ||--o{ message_reactions : "reacts with"
  users |o--o{ users : "reviews registration of"

  chats ||--o{ chat_members : "has roster"
  chats ||--o{ messages : "contains"

  messages ||--o{ attachments : "carries"
  messages ||--o{ message_receipts : "tracks"
  messages ||--o{ message_reactions : "collects"
  messages |o--o{ messages : "is replied to by"

  users {
    uuid   id             PK
    string university_id  UK "the student or staff number"
    string phone_number   UK "nullable - the other way to sign in"
    string password_hash  "argon2id"
    string name
    enum   role           "STUDENT | PROFESSOR | ADMIN"
    enum   status         "PENDING | APPROVED | REJECTED"
    uuid   reviewed_by_id FK "which admin decided - nullable"
    date   reviewed_at    "nullable"
    bool   is_active      "switch off an approved account"
    string device_id      "one live device per account - nullable"
    string avatar_key     "S3 key, never sent to the browser"
    date   last_seen      "nullable"
    date   created_at
    date   updated_at
  }

  sessions {
    uuid   id           PK "travels in the token as sid"
    uuid   user_id      FK
    string device_id
    string user_agent   "a label for the list, never parsed"
    string ip_address   "nullable"
    date   created_at
    date   last_used_at
    date   expires_at
    date   revoked_at   "what makes a token revocable now"
  }

  chats {
    uuid   id              PK
    string title           "nullable for DIRECT"
    enum   type            "DIRECT | GROUP"
    bool   is_read_only    "only chat admins may post"
    uuid   creator_id      FK "their admin seat is permanent"
    date   last_message_at "denormalised, indexed desc"
    date   archived_at     "retired - out of the list, still readable"
    date   deleted_at      "gone from every read path - nullable"
    date   created_at
    date   updated_at
  }

  chat_members {
    uuid user_id   PK, FK
    uuid chat_id   PK, FK
    enum role      "ADMIN | MEMBER - within this chat only"
    bool is_muted
    date joined_at
  }

  messages {
    uuid   id               PK
    string content          "null for a tombstone and for system notes"
    uuid   sender_id        FK "for a system note, who acted"
    uuid   chat_id          FK
    uuid   reply_to_id      FK "self-reference - nullable"
    enum   system_event     "MEMBER_ADDED | MEMBER_REMOVED - nullable"
    uuid   system_target_id FK "who it happened to - nullable"
    bool   is_edited
    bool   is_deleted       "soft, so reply chains survive"
    bool   is_pinned
    date   created_at       "GIN trigram index on content"
    date   updated_at
  }

  attachments {
    uuid   id            PK
    uuid   message_id    FK
    string s3_bucket     "recorded per row, not read from config"
    string s3_object_key "the file never lives in the database"
    string file_name
    string file_type
    int    file_size
    date   created_at
  }

  message_reactions {
    uuid   message_id PK, FK
    uuid   user_id    PK, FK
    string emoji      PK "one person, one emoji, once"
    date   created_at
  }

  message_receipts {
    uuid message_id PK, FK
    uuid user_id    PK, FK
    enum status     "DELIVERED | READ - only ever advances"
    date timestamp
  }
