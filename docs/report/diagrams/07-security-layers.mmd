graph TB
  classDef l fill:#f8fafc,stroke:#475569,stroke-width:2px,color:#0f172a
  classDef hit fill:#fee2e2,stroke:#991b1b,stroke-width:2px,color:#0f172a
  classDef ok fill:#dcfce7,stroke:#166534,stroke-width:2px,color:#0f172a

  REQ([Incoming request]):::l

  L1["<b>1. Network edge - nginx</b><br/>TLS termination, HSTS, nosniff, SAMEORIGIN<br/>only service with a published port<br/>limit_req 30/min on login and register"]:::l
  L2["<b>2. IP allow list - hono/ip-restriction</b><br/>ALLOWED_IP_RANGES, enforced in the API itself<br/>production: the compose subnet only"]:::l
  L3["<b>3. CSRF - hono/csrf</b><br/>Sec-Fetch-Site same-origin, or an exact origin match"]:::l
  L4["<b>4. Token - requireAuth</b><br/>two JWTs, two different secrets, typ claim,<br/>explicit alg on verify"]:::l
  L5["<b>5. Session row</b><br/>sid looked up in sessions;<br/>revoked_at or expiry ends it immediately"]:::l
  L6["<b>6. Device binding</b><br/>token.did must equal users.device_id<br/>otherwise DEVICE_MISMATCH"]:::l
  L7["<b>7. Account state</b><br/>is_active and status = APPROVED"]:::l
  L8["<b>8. Membership - requireChatMember</b><br/>404, never 403 - existence is never confirmed"]:::l
  L9["<b>9. Authorization - policy.ts</b><br/>one pure function per rule, evaluated<br/>server-side against rows the API loaded itself"]:::l
  L10["<b>10. Input - Zod + upload guards</b><br/>MIME allowlist, magic bytes, server-chosen key,<br/>10 MB per file, 5 files per message"]:::l

  GRANT([Request served]):::ok

  REQ --> L1 --> L2 --> L3 --> L4 --> L5 --> L6 --> L7 --> L8 --> L9 --> L10 --> GRANT

