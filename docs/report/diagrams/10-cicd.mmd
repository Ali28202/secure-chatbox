graph LR
  classDef pr fill:#dbeafe,stroke:#1e40af,stroke-width:2px,color:#0f172a
  classDef gate fill:#fef3c7,stroke:#92400e,stroke-width:2px,color:#0f172a
  classDef prod fill:#dcfce7,stroke:#166534,stroke-width:2px,color:#0f172a
  classDef bad fill:#fee2e2,stroke:#991b1b,stroke-width:2px,color:#0f172a

  PR([Pull request]):::pr
  MAIN([Push to main]):::pr

  subgraph VERIFY["Three parallel jobs — a PR gets three independent verdicts"]
    L["<b>Lint</b><br/>bun run lint<br/>bun run lint:e2e"]:::gate
    T["<b>Typecheck</b><br/>bun run typecheck<br/>bun run typecheck:e2e"]:::gate
    E["<b>End-to-end</b><br/>Postgres service container<br/>Chromium --with-deps<br/>109 Playwright tests"]:::gate
  end

  BUILD["<b>build</b> (matrix: api, web)<br/>images built on the runner,<br/>pushed to GHCR as sha + latest"]:::prod
  DEPLOY["<b>deploy</b><br/>scp compose.prod.yml + infra/,<br/>then infra/deploy.sh over SSH"]:::prod
  HEALTH{"health check<br/>answers within 4 min?"}:::gate
  LIVE([Live]):::prod
  ROLL["automatic rollback<br/>to .deploy-state"]:::bad

  PR --> L
  PR --> T
  PR --> E
  MAIN --> L
  MAIN --> T
  MAIN --> E

  L --> BUILD
  T --> BUILD
  E --> BUILD
  BUILD --> DEPLOY --> HEALTH
  HEALTH -->|yes| LIVE
  HEALTH -->|no| ROLL

  NOTE1["A pull request never touches the server."]:::bad
  PR -.-> NOTE1

  NOTE2["Images are built on the runner, never on the server:<br/>3.8 GB of RAM, no swap, and a live Postgres beside it."]:::bad
  BUILD -.-> NOTE2

  NOTE3["Workflow concurrency cancels superseded runs;<br/>deploy sets its own group with cancel-in-progress: false,<br/>so deploys queue instead of interleaving."]:::bad
  DEPLOY -.-> NOTE3
