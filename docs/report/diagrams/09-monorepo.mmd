graph TB
  classDef app fill:#dbeafe,stroke:#1e40af,stroke-width:2px,color:#0f172a
  classDef pkg fill:#dcfce7,stroke:#166534,stroke-width:2px,color:#0f172a
  classDef test fill:#fef3c7,stroke:#92400e,stroke-width:2px,color:#0f172a
  classDef infra fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a

  subgraph APPS["apps/"]
    WEB["<b>@repo/web</b><br/>Next.js 16, React 19<br/>App Router, Tailwind v4, shadcn<br/>8 pages, ~40 components, 11 hooks"]:::app
    API["<b>@repo/api</b><br/>Hono 4 on Bun<br/>6 modules, 4 middleware,<br/>Socket.IO gateway, OpenAPI document"]:::app
  end

  subgraph PKGS["packages/"]
    SHARED["<b>@repo/shared</b><br/>policy.ts, constants.ts,<br/>Zod schemas, DTOs, socket contracts,<br/>Persian formatting"]:::pkg
    DBP["<b>@repo/database</b><br/>Prisma 7 schema,<br/>10 migrations, generated client, seed"]:::pkg
  end

  E2E["<b>e2e/</b><br/>Playwright — 12 specs, 109 tests<br/>not a workspace: its own tsconfig"]:::test
  INFRA["<b>infra/</b><br/>nginx templates, metabase/init.sql,<br/>deploy.sh, deploy-local.sh"]:::infra
  CI["<b>.github/workflows/ci.yml</b><br/>lint · typecheck · e2e<br/>then build + deploy on main"]:::infra

  WEB --> SHARED
  API --> SHARED
  API --> DBP
  DBP --> SHARED

  WEB -. "<b>forbidden edge</b><br/>keeps Prisma WASM out of<br/>the Turbopack graph" .-> DBP

  E2E --> WEB
  E2E --> API
  CI --> E2E
  CI --> INFRA

  ENUM["<b>enum-parity.ts</b><br/>fails typecheck the moment<br/>the two enum definitions drift"]:::infra
  SHARED -.-> ENUM
  DBP -.-> ENUM

  linkStyle 5 stroke:#991b1b,stroke-width:3px,stroke-dasharray: 6 4
